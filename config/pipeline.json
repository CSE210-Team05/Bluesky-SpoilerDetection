{
  "databases": {
    "labels": "data/labels.sqlite3",
    "posts": "data/posts.sqlite3"
  },
  "detectors": {
    "batch_size": 10,
    "poll_seconds": 0.5,
    "tag_config": "config/spoiler_tags.json",
    "write_buffer_size": 100,
    "workers": 5
  },
  "metrics": {
    "allowed_origin": "https://cse210-team05.github.io",
    "caught_up_lag_seconds": 10,
    "cloudflared_executable": "cloudflared",
    "enabled": true,
    "host": "127.0.0.1",
    "live_rate_window_seconds": 10,
    "port": 8765,
    "registry_branch": "live-metrics-endpoint-registry",
    "registry_path": "docs/metrics-endpoint.json",
    "registry_source_branch": "main",
    "repository": "CSE210-Team05/Bluesky-SpoilerDetection",
    "startup_timeout_seconds": 60,
    "tag_config": "config/spoiler_tags.json",
    "tunnel_timeout_seconds": 30,
    "window_seconds": 300
  },
  "publishers": {
    "batch_size": 10,
    "dry_run": true,
    "poll_seconds": 0.5,
    "workers": 1
  },
  "reader": {
    "collection": "app.bsky.feed.post",
    "enabled": true,
    "endpoint": "wss://jetstream2.us-west.bsky.network/subscribe",
    "input": null,
    "max_events": null,
    "max_message_bytes": 4194304,
    "open_timeout": 10,
    "ping_interval": 20,
    "ping_timeout": 20,
    "stream_id": "jetstream2-us-west-posts-v1"
  },
  "supervision": {
    "max_restarts": 5,
    "poll_seconds": 0.5,
    "restart_delay_seconds": 1.0,
    "shutdown_timeout_seconds": 15.0
  }
}
